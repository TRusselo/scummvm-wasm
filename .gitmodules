[submodule "scummvm-core"]
	path = scummvm-core
	# Fork of libretro/scummvm carrying the local commits this build needs
	# (WebMIDI guard, save-state bridge, Emscripten scan root, engine fixes;
	# see docs/pr/PR-DRAFTS.md) that upstream doesn't have. The
	# actual checked-out commit is whatever's recorded in this repo's
	# tree for this path -- this URL just needs to be somewhere that
	# commit is actually fetchable from, which upstream is not.
	url = https://github.com/TRusselo/scummvm-scummvm.git
	branch = emulatorjs-wasm-fixes
[submodule "retroarch"]
	path = retroarch
	# Fork of EmulatorJS/RetroArch carrying our local commits (the
	# save_state_info() dangling-pointer fix, the canvas-size ordering fix,
	# see docs/GOTCHAS.md) on top of the v1.22.2 merge. As with scummvm-core
	# above, this URL just needs to be somewhere that commit is fetchable
	# from.
	url = https://github.com/TRusselo/RetroArch.git
	branch = emulatorjs-wasm-fixes
